{
  "action_manifest_version": 0,
  "app_key": "openvr.component.vrcompositor",
  "controller_type": "questlhsync_knuckles",
  "category": "steamvr_input",
  "name": "QuestLHSync Frame dashboard pointer",
  "description": "Knuckles driven pointer, clicks and system button for the Frame dashboard.",
  "options": {},
  "bindings": {
    "/actions/lasermouse": {
      "haptics": [
        {
          "output": "/actions/lasermouse/out/Haptic",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/lasermouse/out/Haptic",
          "path": "/user/hand/right/output/haptic"
        }
      ],
      "poses": [
        {
          "output": "/actions/lasermouse/in/Pointer",
          "path": "/user/hand/left/pose/aim"
        },
        {
          "output": "/actions/lasermouse/in/Pointer",
          "path": "/user/hand/right/pose/aim"
        }
      ],
      "sources": [
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "parameters": {
            "click_activate_threshold": "0.5",
            "click_deactivate_threshold": "0.45",
            "off_haptic_amplitude": "0"
          },
          "inputs": {
            "click": {
              "output": "/actions/lasermouse/in/LeftClick"
            }
          }
        },
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "click": {
              "output": "/actions/lasermouse/in/MiddleClick"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trackpad",
          "mode": "trackpad",
          "inputs": {
            "position": {
              "output": "/actions/lasermouse/in/TrackpadValue"
            },
            "touch": {
              "output": "/actions/lasermouse/in/TrackpadTouch"
            },
            "click": {
              "output": "/actions/lasermouse/in/RightClick"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "parameters": {
            "click_activate_threshold": "0.5",
            "click_deactivate_threshold": "0.45",
            "off_haptic_amplitude": "0"
          },
          "inputs": {
            "click": {
              "output": "/actions/lasermouse/in/LeftClick"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "click": {
              "output": "/actions/lasermouse/in/MiddleClick"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trackpad",
          "mode": "trackpad",
          "inputs": {
            "position": {
              "output": "/actions/lasermouse/in/TrackpadValue"
            },
            "touch": {
              "output": "/actions/lasermouse/in/TrackpadTouch"
            },
            "click": {
              "output": "/actions/lasermouse/in/RightClick"
            }
          }
        }
      ]
    },
    "/actions/system": {
      "sources": [
        {
          "path": "/user/hand/left/input/system",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/system/in/ToggleDashboard"
            },
            "double": {
              "output": "/actions/system/in/ToggleRoomView"
            },
            "held": {
              "output": "/actions/system/in/SystemButtonChord"
            }
          }
        },
        {
          "path": "/user/hand/right/input/system",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/system/in/ToggleDashboard"
            },
            "double": {
              "output": "/actions/system/in/ToggleRoomView"
            },
            "held": {
              "output": "/actions/system/in/SystemButtonChord"
            }
          }
        }
      ]
    },
    "/actions/scroll_discrete": {
      "sources": [
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "scroll",
          "parameters": {
            "scroll_mode": "discrete"
          },
          "inputs": {
            "scroll": {
              "output": "/actions/scroll_discrete/in/Scroll"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trackpad",
          "mode": "scroll",
          "parameters": {
            "scroll_mode": "discrete"
          },
          "inputs": {
            "scroll": {
              "output": "/actions/scroll_discrete/in/Scroll"
            }
          }
        }
      ]
    },
    "/actions/scroll_smooth": {
      "sources": [
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "scroll",
          "parameters": {
            "scroll_mode": "smooth"
          },
          "inputs": {
            "scroll": {
              "output": "/actions/scroll_smooth/in/Scroll"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trackpad",
          "mode": "scroll",
          "parameters": {
            "scroll_mode": "smooth"
          },
          "inputs": {
            "scroll": {
              "output": "/actions/scroll_smooth/in/Scroll"
            }
          }
        }
      ]
    },
    "/actions/lasermouse_secondary": {
      "sources": [
        {
          "path": "/user/hand/left/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/lasermouse_secondary/in/SwitchLaserHand"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/lasermouse_secondary/in/SwitchLaserHand"
            }
          }
        }
      ]
    }
  }
}